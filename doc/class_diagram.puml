@startuml loki23

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

' ============================================================
' SMART POINTER
' ============================================================

package "loki23.smart_ptr" {

  ' --- Storage Policies ---
  interface StoragePolicy<T> {
    + get() : handle_type
    + set(h : handle_type)
    + {static} null_handle() : handle_type
    + {static} is_valid(h : handle_type) : bool
    + {static} destroy(h : handle_type)
  }

  class DefaultStorage<T> {
    - ptr_ : T* = nullptr
    + get() : T*
    + set(h : T*)
    + {static} null_handle() : T*
    + {static} is_valid(h : T*) : bool
    + {static} destroy(h : T*)
  }

  class LockedStorage<T> {
    - ptr_ : T*
    - mutex_ : std::mutex
    + get() : T*
    + set(h : T*)
    + {static} null_handle() : T*
    + {static} is_valid(h : T*) : bool
    + {static} destroy(h : T*)
  }

  class FileDescriptorStorage<T> {
    - handle_ : int = -1
    + get() : int
    + set(h : int)
    + {static} null_handle() : int
    + {static} is_valid(h : int) : bool
    + {static} destroy(h : int)
  }

  class SocketStorage<T> {
    - handle_ : int = -1
    + get() : int
    + set(h : int)
    + {static} null_handle() : int
    + {static} is_valid(h : int) : bool
    + {static} destroy(h : int)
  }

  DefaultStorage ..|> StoragePolicy
  LockedStorage ..|> StoragePolicy
  FileDescriptorStorage ..|> StoragePolicy
  SocketStorage ..|> StoragePolicy

  ' --- Ownership Policies ---
  interface OwnershipPolicy<T> {
    + acquire(h : handle_type)
    + release(h : handle_type) : bool
  }

  interface Clonable<T> {
    + clone(h : handle_type) : handle_type
  }

  class RefCountBase {
    - count_ : std::size_t*
    + RefCountBase(nullptr_t)
    + RefCountBase(rhs : RefCountBase const&)
    + RefCountBase(rhs : RefCountBase&&)
    + alloc_count()
    + inc_count()
    + dec_count() : bool
    + use_count() : std::size_t
  }

  class AtomicRefCountBase {
    - count_ : std::atomic<std::size_t>*
    + alloc_count()
    + inc_count()
    + dec_count() : bool
    + use_count() : std::size_t
  }

  class RefCounted {
    + acquire(h)
    + clone(h) : handle_type
    + release(h) : bool
    + use_count(h) : int
  }

  class RefCountedMT {
    + acquire(h)
    + clone(h) : handle_type
    + release(h) : bool
    + use_count(h) : int
  }

  class RefLinked {
    - list_ : std::list<RefLinked*>
    + acquire(h)
    + clone(h) : handle_type
    + release(h) : bool
  }

  class Copy {
    + acquire(h)
    + clone(h) : handle_type
    + release(h) : bool
    + use_count(h) : int
  }

  class DeepCopy {
    + clone(h) : handle_type
    + release(h) : bool
  }

  class NoCopy {
    + clone(h) = delete
    + release(h) : bool
  }

  class UniqueOwnership {
    + acquire(h)
    + release(h) : bool
    + use_count(h) : int
  }

  class SharedOwnership {
    + acquire(h)
    + clone(h) : handle_type
    + release(h) : bool
    + use_count(h) : int
  }

  class IntrusiveOwnership {
    + acquire(h)
    + release(h) : bool
    + use_count(h) : int
  }

  RefCounted --|> RefCountBase
  RefCountedMT --|> AtomicRefCountBase
  SharedOwnership --|> RefCountBase

  RefCounted ..|> OwnershipPolicy
  RefCounted ..|> Clonable
  RefCountedMT ..|> OwnershipPolicy
  RefCountedMT ..|> Clonable
  RefLinked ..|> OwnershipPolicy
  RefLinked ..|> Clonable
  Copy ..|> OwnershipPolicy
  Copy ..|> Clonable
  DeepCopy ..|> OwnershipPolicy
  DeepCopy ..|> Clonable
  NoCopy ..|> OwnershipPolicy
  UniqueOwnership ..|> OwnershipPolicy
  SharedOwnership ..|> OwnershipPolicy
  SharedOwnership ..|> Clonable
  IntrusiveOwnership ..|> OwnershipPolicy

  ' --- Checking Policies ---
  interface CheckingPolicy {
    + {static} check(valid : bool)
  }

  class NoCheck {
    + {static} check(valid : bool)
  }

  class AssertCheck {
    + {static} check(valid : bool)
  }

  class ExceptionCheck {
    + {static} check(valid : bool)
  }

  class HaltCheck {
    + {static} check(valid : bool)
  }

  NoCheck ..|> CheckingPolicy
  AssertCheck ..|> CheckingPolicy
  ExceptionCheck ..|> CheckingPolicy
  HaltCheck ..|> CheckingPolicy

  ' --- Conversion Policies ---
  interface ConversionPolicy {
    + {static} implicit_convert() : bool
  }

  class AllowConversion {
    + {static} implicit_convert() : bool
  }

  class DisallowConversion {
    + {static} implicit_convert() : bool
  }

  AllowConversion ..|> ConversionPolicy
  DisallowConversion ..|> ConversionPolicy

  ' --- Main SmartPtr ---
  class SmartPtr<Tval, OwnPolicy, CheckPolicy, StorePolicy> {
    - storage_ : StorePolicy
    - ownership_ : OwnPolicy
    + SmartPtr()
    + SmartPtr(h : handle_type)
    + SmartPtr(rhs : SmartPtr const&)
    + SmartPtr(rhs : SmartPtr&&)
    + ~SmartPtr()
    + operator=(rhs : SmartPtr const&) : SmartPtr&
    + operator=(rhs : SmartPtr&&) : SmartPtr&
    + get() : handle_type
    + valid() : bool
    + use_count() : int
    + operator*() : Tval&
    + operator->() : Tval*
    - clean()
  }

  SmartPtr o-- StoragePolicy
  SmartPtr o-- OwnershipPolicy
  SmartPtr o-- CheckingPolicy
}

' ============================================================
' SINGLETON
' ============================================================

package "loki23.singleton" {

  interface CreationPolicy<T> {
    + {static} create() : T*
    + {static} destroy(p : T*)
  }

  class CreateUsingNew<T> {
    + {static} create() : T*
    + {static} destroy(p : T*)
  }

  class CreateUsingMalloc<T> {
    + {static} create() : T*
    + {static} destroy(p : T*)
  }

  class CreateStatic<T> {
    + {static} create() : T*
    + {static} destroy(p : T*)
  }

  CreateUsingNew ..|> CreationPolicy
  CreateUsingMalloc ..|> CreationPolicy
  CreateStatic ..|> CreationPolicy

  interface LifetimePolicy<T> {
    + {static} schedule_destruction(p : T*, fn : void(*)())
    + {static} on_dead_reference()
  }

  class LifetimeTracker {
    # longevity_ : unsigned int
    + {virtual} ~LifetimeTracker()
    + {static} compare(lhs, rhs) : bool
  }

  class ConcreteLifetimeTracker<T, Destroyer> {
    - tracked_ : T*
    - destroyer_ : Destroyer
    + ~ConcreteLifetimeTracker()
  }

  ConcreteLifetimeTracker --|> LifetimeTracker

  class DefaultLifetime<T> {
    + {static} schedule_destruction(p : T*, fn : void(*)())
    + {static} on_dead_reference()
  }

  class PhoenixSingleton<T> {
    - {static} destroyed_once_ : bool
    + {static} schedule_destruction(p : T*, fn : void(*)())
    + {static} on_dead_reference()
  }

  class SingletonWithLongevity<T> {
    + {static} schedule_destruction(p : T*, fn : void(*)())
    + {static} on_dead_reference()
  }

  class NoDestroy<T> {
    + {static} schedule_destruction(p : T*, fn : void(*)())
    + {static} on_dead_reference()
  }

  DefaultLifetime ..|> LifetimePolicy
  PhoenixSingleton ..|> LifetimePolicy
  SingletonWithLongevity ..|> LifetimePolicy
  NoDestroy ..|> LifetimePolicy

  class SingletonHolder<T, CreationPol, LifetimePol> {
    - {static} pInstance_ : std::atomic<T*>
    - {static} destroyed_ : bool
    - {static} mutex_ : std::mutex
    + {static} instance() : T&
    - {static} destroy_singleton()
  }

  SingletonHolder o-- CreationPolicy
  SingletonHolder o-- LifetimePolicy
}

' ============================================================
' TYPE LIST
' ============================================================

package "loki23.type_list" {

  class type_list<Ts...> {
    ' compile-time type container
  }

  note top of type_list
    Metafunctions: length, type_at,
    index_of, contains, push_front,
    push_back, append, erase, erase_all,
    no_duplicates, replace, replace_all,
    reverse, most_derived, derived_to_front,
    apply, filter, for_each
  end note
}

' ============================================================
' HIERARCHY
' ============================================================

package "loki23.hierarchy" {

  class Holder<T> {
    # initialized : bool
    # union value : T
    + {virtual} ~Holder()
    + {virtual} get() : T&
    + mem_location() : void*
    + is_initialized() : bool
  }

  class LazyHolder<T> {
    - creator : std::function<void(T*)>
    + bind(args...)
    + get() : T& override
  }

  class ImmediateHolder<T> {
    - creator : std::function<void(T*)>
    + bind(args...)
  }

  class DefaultHolder<T> {
    - value : T
    + get() : T&
    + mem_location() : void*
  }

  LazyHolder --|> Holder
  ImmediateHolder --|> Holder
  DefaultHolder --|> Holder

  class Dep<T> {
    - holder : Holder<T>&
  }

  Dep o-- Holder

  class GenScatterHierarchy<Unit, T> {
    ' Inherits Unit<Ti> for each Ti in T
  }

  class GenLinearHierarchy<Unit, T> {
    ' Linear inheritance chain over T
  }

  note bottom of GenScatterHierarchy
    Field<T>(obj) -> Unit<T>&
  end note

  note bottom of GenLinearHierarchy
    Field<T>(obj) -> Unit<T>&
  end note
}

' ============================================================
' DEPENDENCY INJECTION
' ============================================================

package "loki23.di" {

  class From<X> {
    ' Type wrapper for DI resolution
  }

  class Container<Ts...> {
    + resolve(From<X>) : X&
    + resolve(a) : a&&
    + bind<T>(args...)
    + get<T>() : T&
  }

  Container --|> GenLinearHierarchy
  Container ..> LazyHolder : uses
  Container ..> From : uses
}

' ============================================================
' FACTORY
' ============================================================

package "loki23.factory" {

  interface FactoryCreationPolicy<Base, Derived> {
    + {static} create() : SmartPtr<Base, NoCopy>
  }

  class NewCreation {
    + {static} create<Base, Derived>() : SmartPtr<Base, NoCopy>
  }

  class FactoryMethodCreation {
    + {static} create<Base, Derived>() : SmartPtr<Base, NoCopy>
  }

  NewCreation ..|> FactoryCreationPolicy
  FactoryMethodCreation ..|> FactoryCreationPolicy

  class Factory<Base, Types, CreationPolicy> {
    - m_registry : std::unordered_map<string_view, Creator>
    + Factory()
    + create(name : string_view) : SmartPtr<Base, NoCopy>
    + contains(name : string_view) : bool
  }

  class HierarchyFactory<Base, Types, CreationPolicy> {
    ' Inherits GenScatterHierarchy<MakeUnit, Types>
  }

  HierarchyFactory --|> GenScatterHierarchy
  Factory o-- FactoryCreationPolicy
  HierarchyFactory o-- FactoryCreationPolicy
}

' ============================================================
' MULTIMETHODS
' ============================================================

package "loki23.multimethods" {

  enum DispatchPolicy {
    FIRST_MATCH
    ALL_MATCHES
  }

  interface NoMatchPolicy {
    + {static} no_match()
  }

  class NoOpNoMatchPolicy {
    + {static} no_match()
  }

  class ExceptionNoMatchPolicy {
    + {static} no_match()
  }

  class LogNoMatchPolicy {
    + {static} no_match()
  }

  NoOpNoMatchPolicy ..|> NoMatchPolicy
  ExceptionNoMatchPolicy ..|> NoMatchPolicy
  LogNoMatchPolicy ..|> NoMatchPolicy

  class StaticDispatcher<DispatchPol, NoMatchPol, BaseLhs, BaseRhs, Ts...> {
    + dispatch(lhs : BaseLhs&, rhs : BaseRhs&, functors...)
  }

  class DynamicDispatcher<DispatchPol, NoMatchPol, Args...> {
    - callbacks_ : unordered_map / unordered_multimap
    + add<ActualArgs...>(callback : std::function<void(ActualArgs...)>)
    + dispatch(args : Args...)
  }

  class TypeIndexArrayHash<size> {
    + operator()(arr : std::array<type_index, size>) : std::size_t
  }

  StaticDispatcher o-- NoMatchPolicy
  DynamicDispatcher o-- NoMatchPolicy
  DynamicDispatcher o-- TypeIndexArrayHash
}

@enduml
